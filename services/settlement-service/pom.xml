<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.platinumcoin.pix</groupId>
        <artifactId>platinumcoin-pix-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>settlement-service</artifactId>
    <packaging>jar</packaging>

    <name>PlatinumCoin Pix — settlement-service</name>
    <description>The SPI connector (port 8086). Step 31 delivers the first queue-driven consumer:
        long-poll settlement-queue, dedupe by eventId, call BACEN's POST /spi/settlements, and drive the
        guarded transitions DEBITED→SENT_TO_SPI→SETTLED with a PixSettled outbox event. Happy path only —
        retries/DLQ (step 32), reversal (step 33) and reconciliation (steps 34–35) follow.</description>

    <!-- No <version> on any dependency: all versions come from the parent's BOMs. -->
    <dependencies>
        <!-- Shared library: error model, correlation-id filter + log pattern, event envelope,
             ProcessedEventStore (the consumer dedup gate this service is the first user of). -->
        <dependency>
            <groupId>com.platinumcoin.pix</groupId>
            <artifactId>common-lib</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web + Actuator. This service exposes NO business endpoint — its only inbound adapter is a
             queue consumer — but it still serves /actuator/health so compose can gate on it, and
             spring-boot-starter-web is what common-lib's RestClient customizer and the Boot web stack
             need for the outbound SPI call. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- DynamoDB SDK v2: the guarded status transitions and the PixSettled outbox item are written
             straight to pix_transactions (ADR-0006's documented exception to table ownership — an
             internal API between writer and table would reintroduce the dual write the outbox exists to
             remove). Confined to infra/; the ArchUnit test fails the build if domain/ imports it. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>

        <!-- SQS SDK v2: the settlement-queue long poll. The receive/delete calls live in the INBOUND
             adapter (api/SettlementQueueConsumer) — a queue is a way of entering the application, the
             same as a controller's servlet stack. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>

        <!-- Context-load + consumer ITs (*IT → failsafe, runs on `mvn verify`). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Reusable LocalStack harness (LocalStackTestBase) published by common-lib as a test-jar.
             Test-scope deps of a test-jar are NOT transitive, so the Testcontainers deps below are
             re-declared here (accepted trade-off, per common-lib/pom.xml). -->
        <dependency>
            <groupId>com.platinumcoin.pix</groupId>
            <artifactId>common-lib</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SNS SDK, TEST scope only: SettlementHappyIT publishes a PixDebited to the real `pix-events`
             topic so the message reaches the consumer through the SAME fan-out + filter policy the
             platform uses (step 26), rather than being hand-placed on the queue. The service itself
             never touches SNS — it writes its event to the outbox and payment-service's publisher
             drains it (ADR-0004). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: enforces ADR-0010 rule 1 + ADR-0011 rule 6 (see SettlementArchitectureTest). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackage into a runnable, layered fat jar so `java -jar target/*.jar` and the
                 Dockerfile's layered extraction both work (same pattern as the other services). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
