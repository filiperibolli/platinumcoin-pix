<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.platinumcoin.pix</groupId>
        <artifactId>platinumcoin-pix-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>notification-service</artifactId>
    <packaging>jar</packaging>

    <name>PlatinumCoin Pix — notification-service</name>
    <description>The real-time push service (port 8087). Step 38 delivers the platform's first
        LONG-LIVED-CONNECTION service: GET /v1/notifications/stream holds one SSE connection per
        authenticated account, a queue consumer long-polls notification-queue and routes each
        user-facing event (PixSettled / PixReceived / PixReversed) to the affected account's emitters
        only, heartbeats defeat idle timeouts and disconnects clean up. Deliberately best-effort: a
        missed push degrades UX, never correctness — the state stays queryable on
        GET /payments/{id}. Step 39 standardizes the pushed payload on the external status vocabulary.</description>

    <!-- No <version> on any dependency: all versions come from the parent's BOMs. -->
    <dependencies>
        <!-- Shared library: error model, correlation-id filter + log pattern, JWT validation filter,
             event envelope, ProcessedEventStore (the dedup gate this consumer shares with settlement). -->
        <dependency>
            <groupId>com.platinumcoin.pix</groupId>
            <artifactId>common-lib</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web + Actuator. The web stack is load-bearing here in a way it is not elsewhere: SseEmitter
             IS Spring MVC's async-request abstraction, so the servlet container's async support is the
             transport this whole service is built on. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Prometheus scrape endpoint (step 44): turns the Micrometer meters this service already
             records into /actuator/prometheus, the one surface the Prometheus container scrapes.
             Runtime scope — no code compiles against the registry; it is discovered and wired by
             Actuator's auto-configuration the moment it is on the classpath. Version via the Spring
             Boot BOM in the parent. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- SQS SDK v2: the notification-queue long poll. The receive/delete calls live in the INBOUND
             adapter (api/NotificationQueueConsumer) — a queue is a way of entering the application. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>

        <!-- DynamoDB SDK v2: ONLY for pix_processed_events, the shared consumer-dedup gate (ADR-0006's
             documented cross-service table). This service owns no business table and writes no money —
             it reads no ledger and no transaction. Confined to infra/; the ArchUnit test fails the build
             if domain/ imports it. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>

        <!-- Context-load + SSE/consumer ITs (*IT → failsafe, runs on `mvn verify`). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Reusable LocalStack harness (LocalStackTestBase) published by common-lib as a test-jar.
             Test-scope deps of a test-jar are NOT transitive, so the Testcontainers deps below are
             re-declared here (accepted trade-off, per common-lib/pom.xml). -->
        <dependency>
            <groupId>com.platinumcoin.pix</groupId>
            <artifactId>common-lib</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SNS SDK, TEST scope only: SseIT publishes each event to the real `pix-events` topic so the
             message reaches this consumer through the SAME fan-out + filter policy the platform uses
             (step 36), rather than being hand-placed on the queue. The service itself never touches SNS. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: enforces ADR-0010 rule 1 + ADR-0011 rule 6 (see NotificationArchitectureTest). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackage into a runnable, layered fat jar so `java -jar target/*.jar` and the
                 Dockerfile's layered extraction both work (same pattern as the other services). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
