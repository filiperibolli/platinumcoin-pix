<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.platinumcoin.pix</groupId>
        <artifactId>platinumcoin-pix-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>payment-service</artifactId>
    <packaging>jar</packaging>

    <name>PlatinumCoin Pix — payment-service</name>
    <description>The send-Pix entry point (port 8084). Step 18 delivers the walking skeleton of
        POST /v1/payments/pix — JWT-authenticated, validated, txId/endToEndId generated, persisted as
        RECEIVED, 202 + Location — before steps 19–21 add idempotency, limits and the ledger debit.</description>

    <!-- No <version> on any dependency: all versions come from the parent's BOMs. -->
    <dependencies>
        <!-- Shared library: error model, correlation-id filter + log pattern, JWT validation. -->
        <dependency>
            <groupId>com.platinumcoin.pix</groupId>
            <artifactId>common-lib</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web + Actuator: the service owns port 8084 and reports health. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Bean Validation for the send request body (pixKey/amount pattern/description length).
             common-lib ships validation only in test scope, so a service that validates its own
             request bodies declares the starter itself. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DynamoDB SDK v2. Confined to infra/ (DynamoTransactionRepository, DynamoConfig); the
             ArchUnit test fails the build if a domain type imports software.amazon.awssdk.*. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>

        <!-- SNS SDK v2 (step 29): the outbox publisher drains the sparse index to the `pix-events`
             topic. Publish-only — payment-service owns no queue and needs no SQS at runtime (the
             fan-out is SNS's job, and the least-privilege policy of ADR-0013 is just sns:Publish on
             one topic). Confined to infra/client + infra/config like every other AWS type. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
        </dependency>

        <!-- Context-load + controller ITs (*IT → failsafe, runs on `mvn verify`). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Reusable LocalStack harness (LocalStackTestBase) published by common-lib as a test-jar.
             Test-scope deps of a test-jar are NOT transitive, so the Testcontainers deps below are
             re-declared here (accepted trade-off, per common-lib/pom.xml). -->
        <dependency>
            <groupId>com.platinumcoin.pix</groupId>
            <artifactId>common-lib</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SQS SDK, TEST scope only (step 29): OutboxPublisherIT asserts a published event actually
             ARRIVES on settlement-queue — i.e. that the fan-out and the eventType filter policy of
             step 26 accept what this service publishes. The service itself never touches SQS. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: enforces ADR-0010 rule 1 + ADR-0011 rule 6 (see PaymentArchitectureTest). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackage into a runnable, layered fat jar so `java -jar target/*.jar` and the
                 Dockerfile's layered extraction both work (same pattern as the other services). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
