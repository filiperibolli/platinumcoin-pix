<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.platinumcoin.pix</groupId>
        <artifactId>platinumcoin-pix-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-lib</artifactId>
    <packaging>jar</packaging>

    <name>PlatinumCoin Pix — common-lib</name>
    <description>Thin shared library: error model, JWT validation, logging, event envelope. Keep it THIN.</description>

    <!-- No <version> on any dependency: all versions come from the parent's BOMs. -->
    <dependencies>
        <!-- Minimal Spring Boot core (no web/AWS here — common-lib stays thin) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Structured JSON logging encoder used by the shared logback-spring.xml that this
             library auto-ships to every consumer. Compile scope so consuming services get the
             encoder on their runtime classpath. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- HS256 JWT validation is a common-lib responsibility (one validator, no drift): every
             consuming service inherits a working parser transitively. api is compile scope (the
             filter compiles against the fluent parser); impl + jackson are runtime-only, resolved
             via ServiceLoader. NOT optional — unlike web, a service that skips validation is a bug. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- DynamoDB SDK v2, OPTIONAL (step 29 promoted it from test scope): ProcessedEventStore —
             the shared consumer-dedup gate every queue consumer must call before its side effect
             (ADR-0004/ADR-0006) — is a DynamoDB adapter, so common-lib has to compile against the
             SDK. `optional` keeps it OFF the transitive classpath, exactly like the web types
             below: the consumers that dedupe (settlement, notification, audit) already declare the
             SDK themselves, and auth-service, which touches no AWS at all, stays clean. common-lib
             stays THIN. Version via the AWS SDK BOM in the parent. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Web types are OPTIONAL: common-lib compiles the filter, @RestControllerAdvice and
             RestClientCustomizer against them, but does NOT force web onto every consumer.
             Each service brings its own spring-boot-starter-web; the auto-configuration is
             guarded by @ConditionalOnClass so it only activates in web apps. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 (managed by the Spring Boot BOM) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Web stack in test scope so MockMvc can exercise the shared advice/filter here,
             even though production consumers supply web themselves. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers LocalStack harness (LocalStackTestBase) — TEST scope only: the disposable
             integration-test emulator never ships to consumers, keeping common-lib THIN at runtime.
             Versions come from the Testcontainers BOM in the parent. Consuming service modules that
             extend the base re-declare these three in their own test scope (test-scope deps of a
             test-jar are not transitive) — the accepted trade-off for the reuse. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SNS + SQS SDKs, TEST scope only (step 26): MessagingInitIT asserts the messaging
             backbone the init scripts create (topic, queues, redrive, filter policy). The
             services that actually publish/consume declare these in their own compile scope —
             common-lib stays THIN at runtime. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Publish the reusable *IT harness as a test-jar so later service modules can
                 `extends LocalStackTestBase` by depending on common-lib with <type>test-jar</type>. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>publish-test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
