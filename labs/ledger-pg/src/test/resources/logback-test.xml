<?xml version="1.0" encoding="UTF-8"?>
<!--
  The lab has no common-lib, so it has no LOG_CORRELATION_PATTERN and no json-logs profile — there is
  no request to correlate here. What it keeps from ADR-0012 is the posture: our package at DEBUG, so
  the SQL each strategy actually issues is visible while reading a test run, and everything else quiet.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.platinumcoin.pix" level="DEBUG"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="tc" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
