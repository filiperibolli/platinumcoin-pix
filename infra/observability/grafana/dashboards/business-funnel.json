          "editorMode": "code",
          "expr": "sum(rate(pix_fraud_decision_total{decision=\"SKIPPED\"}[10m])) / sum(rate(pix_fraud_decision_total[10m]))",
          "legendFormat": "skipped share",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
