{
  "uid": "pix-technical",
  "title": "PlatinumCoin Pix \u2014 Technical",
  "description": "Latency against the stated SLOs, throughput, faults, queue health and JVM basics. The board an engineer opens. Its business counterpart is 'PlatinumCoin Pix \u2014 Business Funnel'. Provisioned from infra/observability/ (step 44) \u2014 edits here do not persist; edit the JSON in the repo.",
  "tags": [
    "platinumcoin",
    "technical",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Send Pix \u2014 p99 vs 2s SLO (KR2.1)",
      "description": "The acknowledgement latency of POST /v1/payments/pix. The quantile is computed by Prometheus from the histogram buckets, not by each JVM \u2014 averaging per-instance p99s would not be a percentile of anything. The dashed line is the budget, not a measurement.",
      "datasource": {
        "type": "prometheus",
        "uid": "platinumcoin-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": ""
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SLO 2s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platinumcoin-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/v1/payments/pix\",method=\"POST\"}[5m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platinumcoin-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/v1/payments/pix\",method=\"POST\"}[5m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platinumcoin-prometheus"
          },
          "editorMode": "code",
          "expr": "vector(2)",
          "legendFormat": "SLO 2s",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ]
    },
