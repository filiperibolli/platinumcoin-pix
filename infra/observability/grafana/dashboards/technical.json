    {
      "id": 3,
      "type": "stat",
      "title": "Send inside SLO",
      "description": "The share of sends that met the 2s budget — a division of two counters, exact, because common-lib registers a bucket at exactly the SLO boundary.",
      "datasource": {
        "type": "prometheus",
        "uid": "platinumcoin-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNonNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platinumcoin-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_bucket{uri=\"/v1/payments/pix\",method=\"POST\",le=\"2.0\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri=\"/v1/payments/pix\",method=\"POST\"}[5m]))",
          "legendFormat": "within 2s",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
