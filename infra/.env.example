# PlatinumCoin Pix — local environment template.
#
# Copy to `infra/.env` (git-ignored) if you want compose / your shell to pick these up:
#   cp infra/.env.example infra/.env
#
# These are DUMMY values for LocalStack. LocalStack does not authenticate — any
# non-empty AWS credentials are accepted — so committing these placeholders is safe.
# A real AWS deployment injects managed credentials and a real endpoint instead.
#
# Who consumes them:
#   - the AWS CLI and the AWS SDK clients (added from step 07 onward) read AWS_* to
#     talk to DynamoDB/SNS/SQS/S3 at the LocalStack endpoint;
#   - the `localstack` container itself needs NONE of these to serve DynamoDB, so
#     docker-compose.yml does not wire this file into it in step 06 (nothing to wire
#     yet). The env_file/service wiring lands with the first AWS-using service.

# Dummy static credentials (LocalStack accepts anything non-empty).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Region every table/queue/topic is created in and addressed by. Keep consistent
# across init scripts and service clients.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# LocalStack endpoint.
#   - From the host (AWS CLI, IDE): http://localhost:4566
#   - From another container on pix-net: http://localstack:4566
# Service clients set this to override the default AWS endpoints.
AWS_ENDPOINT_URL=http://localhost:4566
